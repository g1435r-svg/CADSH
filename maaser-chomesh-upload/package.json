{
  "name": "maaser-chomesh-app",
  "version": "1.0.0",
  "description": "מחשבון מעשרות וחומש עם גיבוי",
  "main": "electron-main.js",
  "scripts": {
    "vendor:copy": "node scripts/copy-vendor.js",
    "prestart": "npm run vendor:copy",
    "start": "electron .",
    "prebuild:exe": "npm run vendor:copy",
    "build:exe": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "chart.js": "4.4.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.local.maaserchomesh",
    "productName": "MaaserChomesh",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron-main.js",
      "preload.js",
      "vendor/**",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "MaaserChomesh.exe",
      "signAndEditExecutable": false
    }
  },
  "author": "g1435r-svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g1435r-svg/CADSH.git"
  }
}
