{
  "name": "maaser-chomesh-app",
  "version": "1.0.0",
  "description": "מחשבון מעשרות וחומש עם גיבוי",
  "main": "electron-main.js",
  "scripts": {
    "prepare:vendor": "node scripts/prepare-vendor.js",
    "start": "npm run prepare:vendor && electron .",
    "build:exe": "npm run prepare:vendor && electron-builder --win --x64"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.maaserchomesh",
    "productName": "MaaserChomesh",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron-main.js",
      "vendor/chart.umd.js",
      "vendor/exceljs.min.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "MaaserChomesh.exe"
    }
  }
}
